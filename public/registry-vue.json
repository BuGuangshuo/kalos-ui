          "path": "pop-select.vue",
          "type": "registry:ui",
          "content": "<script setup lang=\"ts\">\nimport { useId } from \"vue\";\nimport {\n  Select,\n  SelectTrigger,\n  SelectValue,\n  SelectContent,\n  SelectItem,\n} from \"@/components/ui/select\";\ndefineProps<{\n  label: string;\n  placeholder?: string;\n  items: { value: string; label: string }[];\n  disabled?: boolean;\n  name?: string;\n  id?: string;\n}>();\nconst autoId = useId();\nconst model = defineModel<string>();\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-1.5\">\n    <label :for=\"id || autoId\" class=\"text-sm font-medium\">{{ label }}</label>\n    <Select v-model=\"model\" :disabled=\"disabled\" :name=\"name\"\n      ><SelectTrigger\n        :id=\"id || autoId\"\n        class=\"h-8 w-full rounded-[var(--radius-element,12px)]\"\n        ><SelectValue :placeholder=\"placeholder || '请选择'\" /></SelectTrigger\n      ><SelectContent\n        ><SelectItem\n          v-for=\"item in items\"\n          :key=\"item.value\"\n          :value=\"item.value\"\n          >{{ item.label }}</SelectItem\n        ></SelectContent\n      ></Select\n    >\n  </div>\n</template>\n"
        }
