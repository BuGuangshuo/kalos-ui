{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pop-checkbox",
  "type": "registry:ui",
  "title": "Pop 复选框 · Vue",
  "description": "选择一个或多个选项，支持选中与不确定状态。",
  "author": "Alan Bu <https://github.com/BuGuangshuo>",
  "registryDependencies": [
    "checkbox"
  ],
  "files": [
    {
      "path": "pop-checkbox.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { useId } from \"vue\";\nimport { Checkbox } from \"@/components/ui/checkbox\";\ndefineOptions({ inheritAttrs: false });\ndefineProps<{\n  label: string;\n  description?: string;\n  id?: string;\n  disabled?: boolean;\n  name?: string;\n}>();\nconst autoId = useId();\nconst model = defineModel<boolean | \"indeterminate\">({ default: false });\n</script>\n\n<template>\n  <div class=\"flex items-start gap-3\">\n    <Checkbox\n      v-bind=\"$attrs\"\n      :id=\"id || autoId\"\n      v-model=\"model\"\n      :name=\"name\"\n      :disabled=\"disabled\"\n      class=\"shrink-0 focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0 focus-visible:border-input data-checked:focus-visible:border-primary\"\n    />\n    <label\n      :for=\"id || autoId\"\n      class=\"flex cursor-pointer flex-col gap-1 text-sm font-medium\"\n      >{{ label\n      }}<span\n        v-if=\"description\"\n        class=\"text-xs font-normal text-muted-foreground\"\n        >{{ description }}</span\n      ></label\n    >\n  </div>\n</template>\n"
    }
  ]
}
