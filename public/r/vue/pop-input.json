{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pop-input",
  "type": "registry:ui",
  "title": "Pop 文本输入 · Vue",
  "description": "将标签、输入、说明和校验提示组合在一起。",
  "author": "Alan Bu <https://github.com/BuGuangshuo>",
  "registryDependencies": [
    "input"
  ],
  "files": [
    {
      "path": "pop-input.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { useId } from \"vue\";\nimport { Input } from \"@/components/ui/input\";\ndefineOptions({ inheritAttrs: false });\nconst props = defineProps<{\n  label: string;\n  hint?: string;\n  error?: string;\n  id?: string;\n}>();\nconst autoId = useId();\nconst model = defineModel<string | number>({ default: \"\" });\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-1.5\">\n    <label :for=\"props.id || autoId\" class=\"text-sm font-medium\">{{\n      label\n    }}</label>\n    <Input\n      v-bind=\"$attrs\"\n      :id=\"props.id || autoId\"\n      v-model=\"model\"\n      class=\"h-8 rounded-[var(--radius-element,12px)]\"\n      :aria-invalid=\"!!error\"\n      :aria-describedby=\"\n        error || hint ? `${props.id || autoId}-description` : undefined\n      \"\n    />\n    <p\n      v-if=\"error || hint\"\n      :id=\"`${props.id || autoId}-description`\"\n      class=\"text-xs\"\n      :class=\"error ? 'text-destructive' : 'text-muted-foreground'\"\n    >\n      {{ error || hint }}\n    </p>\n  </div>\n</template>\n"
    }
  ]
}
