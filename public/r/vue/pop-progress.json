{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pop-progress",
  "type": "registry:ui",
  "title": "Pop 进度条 · Vue",
  "description": "清晰地展示任务进展，支持数值、标题与辅助说明。",
  "author": "Alan Bu <https://github.com/BuGuangshuo>",
  "registryDependencies": [
    "progress"
  ],
  "files": [
    {
      "path": "pop-progress.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { Progress } from \"@/components/ui/progress\";\nconst props = defineProps<{\n  label: string;\n  value: number;\n  description?: string;\n}>();\nconst progress = computed(() =>\n  Number.isFinite(props.value) ? Math.min(100, Math.max(0, props.value)) : 0,\n);\n</script>\n\n<template>\n  <div class=\"flex w-full flex-col gap-2.5\">\n    <div class=\"flex items-center justify-between gap-4 text-sm\">\n      <span class=\"font-medium\">{{ label }}</span\n      ><span class=\"tabular-nums text-muted-foreground\">{{ progress }}%</span>\n    </div>\n    <Progress :model-value=\"progress\" :aria-label=\"label\" class=\"h-1.5\" />\n    <p v-if=\"description\" class=\"text-xs text-muted-foreground\">\n      {{ description }}\n    </p>\n  </div>\n</template>\n"
    }
  ]
}
