{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pop-switch",
  "type": "registry:ui",
  "title": "Pop 开关 · Vue",
  "description": "在两个互斥状态间切换，适用于立即生效的设置。",
  "author": "Alan Bu <https://github.com/BuGuangshuo>",
  "registryDependencies": [
    "switch"
  ],
  "files": [
    {
      "path": "pop-switch.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { useId } from \"vue\";\nimport { Switch } from \"@/components/ui/switch\";\ndefineOptions({ inheritAttrs: false });\ndefineProps<{\n  label: string;\n  description?: string;\n  id?: string;\n  disabled?: boolean;\n  name?: string;\n}>();\nconst autoId = useId();\nconst model = defineModel<boolean>({ default: false });\n</script>\n\n<template>\n  <div class=\"flex items-center justify-between gap-6\">\n    <label\n      :for=\"id || autoId\"\n      class=\"flex cursor-pointer flex-col gap-1 text-sm font-medium\"\n      >{{ label\n      }}<span\n        v-if=\"description\"\n        class=\"text-xs font-normal text-muted-foreground\"\n        >{{ description }}</span\n      ></label\n    >\n    <Switch\n      v-bind=\"$attrs\"\n      :id=\"id || autoId\"\n      v-model=\"model\"\n      :name=\"name\"\n      :disabled=\"disabled\"\n      class=\"shrink-0\"\n    />\n  </div>\n</template>\n"
    }
  ]
}
