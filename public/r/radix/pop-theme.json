{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pop-theme",
  "title": "Pop Theme",
  "description": "参考 Astryx 的中性黑白配色，包含浅色与深色语义变量。",
  "cssVars": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "primary": "#1b1b1b",
      "primary-foreground": "#ffffff",
      "muted": "#f1f1f1",
      "muted-foreground": "#474747",
      "border": "#00000014",
      "input": "#d4d4d4",
      "accent": "#0000000f",
      "destructive": "#c9303a",
      "radius": "1rem"
    },
    "dark": {
      "background": "#1b1b1b",
      "foreground": "#ffffff",
      "primary": "#f1f1f1",
      "primary-foreground": "#111111",
      "muted": "#262626",
      "muted-foreground": "#9e9e9e",
      "border": "#ffffff1a",
      "input": "#525252",
      "accent": "#ffffff1a",
      "destructive": "#ff705d"
    }
  },
  "type": "registry:theme"
}
