{
  "name": "kalos-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run search:build && npm run cli:build && next dev",
    "build": "npm run brand:build && npm run registry:build && npm run search:build && npm run cli:build && next build",
    "start": "next start",
    "lint": "eslint",
    "mcp": "shadcn mcp",
    "mcp:config": "node scripts/configure-mcp.mjs",
    "mcp:test": "node --test scripts/mcp.test.mjs scripts/component-prompt.test.mjs",
    "brand:build": "node scripts/build-brand.mjs",
    "cli:build": "node scripts/build-installer.mjs",
    "cli:test": "node --test packages/cli/test/*.test.mjs",
    "registry:build": "npm run styles:build && node scripts/prepare-registry.mjs && shadcn build && node scripts/verify-registry.mjs && node scripts/build-base-registry.mjs",
    "typecheck": "tsc --noEmit",
    "styles:build": "node scripts/build-component-styles.mjs",
    "search:build": "node scripts/build-search-index.mjs",
    "search:test": "node --test scripts/search.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@number-flow/react": "0.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "topojson-client": "3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.16.0",
  "type": "module"
}
